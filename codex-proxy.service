[Unit]
Description=Codex Multi-Key Proxy
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory={{PROXY_DIR}}
ExecStart=/usr/bin/node --max-old-space-size=8192 {{PROXY_DIR}}/proxy.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
